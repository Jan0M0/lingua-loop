{
  "name": "lingua-loop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lingua Loop — 本地优先、离线可用、0 Token 的 IELTS 8 + 西语 B2 自适应训练应用",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/fix-script-tag.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "vitest run tests/content.test.ts"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  }
}
